{
  "name": "robot-telemetry",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 4 },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "관제 대시보드", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "pip install -r requirements.txt pytest httpx rosbags"
}
